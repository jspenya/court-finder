<%= form_with url: search_path, method: :post, scope: :search, class: "search-form", data: { action: "turbo:submit-start->search-form#showLoading turbo:submit-end->search-form#hideLoading" } do |form| %>
  <% if search_error.present? %>
    <p class="form__error" role="alert"><%= search_error %></p>
  <% end %>

  <div class="play-window-picker"
       data-controller="play-window-picker"
       data-play-window-picker-inline-value="true"
       data-play-window-picker-min-date-value="<%= Time.zone.today.iso8601 %>">
    <%= form.hidden_field :date,
          value: search_defaults[:date],
          required: true,
          data: { play_window_picker_target: "dateField" } %>
    <%= form.hidden_field :play_time,
          value: search_defaults[:play_time],
          required: true,
          data: { play_window_picker_target: "playTimeField" } %>
    <%= form.hidden_field :play_time_end,
          value: search_defaults[:play_time_end],
          required: true,
          data: { play_window_picker_target: "playTimeEndField" } %>

    <%= form.hidden_field :day_parts,
          value: search_defaults[:day_parts],
          data: { play_window_picker_target: "dayPartsField" } %>

    <span data-play-window-picker-target="triggerLabel" hidden></span>
    <div class="play-window-picker__panel" data-play-window-picker-target="panel">
          <div class="play-window-picker__panel-body">
            <div class="play-window-picker__date">
              <label for="play-date" class="play-window-picker__section-label">Play date</label>
              <%= tag.input type: "text",
                    id: "play-date",
                    autocomplete: "off",
                    class: "field__input",
                    data: { play_window_picker_target: "dateInput" },
                    value: search_defaults[:date] %>
            </div>

            <div class="play-window-picker__times">
              <div class="play-window-picker__time-field">
                <label for="play-from" class="play-window-picker__section-label">From</label>
              <div class="play-window-picker__time-control">
                <%= tag.input type: "text",
                      autocomplete: "off",
                      id: "play-from",
                      data: { play_window_picker_target: "playTimeInput" },
                      value: search_defaults[:play_time] %>
              </div>
              </div>

              <svg class="play-window-picker__times-separator" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M9 6l6 6-6 6" />
              </svg>

              <div class="play-window-picker__time-field">
                <label for="play-until" class="play-window-picker__section-label">Until</label>
              <div class="play-window-picker__time-control">
                <%= tag.input type: "text",
                      autocomplete: "off",
                      id: "play-until",
                      data: { play_window_picker_target: "playTimeEndInput" },
                      value: search_defaults[:play_time_end] %>
              </div>
              </div>
            </div>
            <div class="play-window-picker__presets" role="group" aria-label="Quick time choices">
              <div class="play-window-picker__preset-row">
                <% play_window_presets.each do |preset| %>
                  <button type="button"
                          class="play-window-picker__preset"
                          data-play-window-picker-target="preset"
                          data-action="click->play-window-picker#applyPreset"
                          data-play-window-picker-part-param="<%= preset[:name] == "All Day" ? "" : preset[:name].downcase %>"
                          data-play-window-picker-start-param="<%= preset[:start] %>"
                          data-play-window-picker-end-param="<%= preset[:end] %>"
                          aria-pressed="false"
                          aria-label="<%= preset[:name] %>, <%= preset[:range] %>">
                    <span class="play-window-picker__preset-name"><%= preset[:name] %></span>
                    <span class="play-window-picker__preset-range"><%= preset[:range] %></span>
                  </button>
                <% end %>
              </div>
            </div>

            <%= form.submit "Check availability", class: "button button--primary",
                  data: { search_form_target: "submit" } %>
          </div>

          <p class="play-window-picker__error" data-play-window-picker-target="error" hidden role="alert"></p>
        </div>
  </div>
<% end %>
