<% venues = Availability::VenueCatalog.all %>

<div class="results"
     data-controller="search-results"
     data-search-results-venue-count-value="<%= venues.size %>"
     data-search-results-play-time-value="<%= search.play_time.iso8601 %>">
  <div class="results__header">
    <h2 class="results__count" data-search-results-target="count" aria-live="polite">Checking <%= pluralize(venues.size, "venue") %>…</h2>
    <p class="results__meta" data-search-results-target="meta" hidden></p>
  </div>
  <p class="results__window"><%= search.date.strftime("%a, %-d %b") %> · <%= format_play_time_window(search) %></p>
  <p class="results__progress" data-search-results-target="progress" role="status"></p>

  <div class="results__list" data-search-results-target="list">
    <% venues.each do |venue| %>
      <%= turbo_frame_tag "venue_#{venue.id}",
            src: search_venue_frame_path(venue, search),
            data: { status: "pending", latitude: venue.config["latitude"], longitude: venue.config["longitude"] } do %>
        <%= render "pending", venue: %>
      <% end %>
    <% end %>
  </div>

  <div data-search-results-target="empty" hidden>
    <%= render "empty", search:, checked_at: Time.zone.now %>
  </div>
</div>
