<article class="result result--venue" data-controller="booking-handoff">
  <header class="result__header">
    <div class="result__header-text">
      <h2 class="result__title"><%= result.venue.name %></h2>
      <%= venue_location_link(result.venue) %>
      <p class="result__summary" data-venue-distance hidden></p>
      <p class="result__summary"><%= result_availability_summary(result) %></p>
    </div>
    <div class="result__handoff">
      <%= link_to "Book on site",
            result.venue.booking_url,
            class: "button button--small button--outline result__book",
            data: { action: "booking-handoff#open", booking_handoff_target: "link" },
            aria: { haspopup: "dialog" },
            target: "_blank",
            rel: "noopener" %>

    </div>
  </header>

  <% ranges = venue_availability_ranges(result, search:) %>
  <div class="availability" aria-label="Available times across courts">
    <div class="availability__axis" aria-hidden="true">
      <% availability_axis_labels(search).each do |label| %>
        <span><%= label %></span>
      <% end %>
    </div>
    <div class="availability__track" aria-hidden="true">
      <% ranges.each do |starts_at, ends_at| %>
        <span class="availability__bar" style="<%= availability_bar_style(starts_at, ends_at, search) %>"></span>
      <% end %>
    </div>
    <p class="availability__times"><%= ranges.map { |starts_at, ends_at| "#{starts_at.strftime('%-I:%M %p')}–#{ends_at.strftime('%-I:%M %p')}" }.join(" · ") %></p>
  </div>

  <details class="result__courts">
    <summary>Courts & times <span aria-hidden="true">+</span></summary>
    <% result.court_schedules.each do |court_name, periods| %>
      <div class="result__court-row">
        <span class="result__court-name"><%= court_name.presence || "Court" %></span>
        <div class="result__periods">
          <% periods.each do |period_name, period_slots| %>
            <div class="result__period">
              <span class="result__period-label"><%= period_name %></span>
              <div class="result__slot-chips">
                <% period_slots.each do |slot| %>
                  <span class="result__slot-chip"><%= format_slot_time_compact(slot) %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </details>
  <dialog class="booking-dialog" data-booking-handoff-target="dialog"
          data-action="close->booking-handoff#restoreFocus click->booking-handoff#dismissBackdrop"
          aria-labelledby="booking-title-<%= result.venue.id %>"
          aria-describedby="booking-description-<%= result.venue.id %>">
    <h2 id="booking-title-<%= result.venue.id %>">Continue to <%= result.venue.name %>?</h2>
    <p id="booking-description-<%= result.venue.id %>">Re-enter your date and time on the venue’s site. They won’t carry over.</p>
    <p class="booking-dialog__selection"><strong><%= search.date.strftime("%A, %-d %B %Y") %></strong><br><%= format_play_time_window(search) %> · Philippine time</p>
    <button type="button" class="button button--primary" data-action="booking-handoff#continue" autofocus>Continue to booking</button>
  </dialog>
</article>
