<article class="result result--venue">
  <header class="result__header">
    <div class="result__header-text">
      <h2 class="result__title"><%= result.venue.name %></h2>
      <%= venue_location_link(result.venue) %>
      <p class="result__summary" data-venue-distance hidden></p>
      <p class="result__summary"><%= result_availability_summary(result) %></p>
    </div>
    <div class="result__handoff">
      <%= link_to "Book on site",
            result.venue.booking_url,
            class: "button button--small button--outline result__book",
            target: "_blank",
            rel: "noopener" %>
      <% if (hint = booking_handoff_date_hint(search)) %>
        <p class="result__handoff-hint"><%= hint %></p>
      <% end %>
    </div>
  </header>

  <% ranges = venue_availability_ranges(result) %>
  <div class="availability" aria-label="Available times across courts">
    <div class="availability__axis" aria-hidden="true"><span>12 AM</span><span>12 PM</span><span>12 AM</span></div>
    <div class="availability__track" aria-hidden="true">
      <% ranges.each do |starts_at, ends_at| %>
        <span class="availability__bar" style="<%= availability_bar_style(starts_at, ends_at, search.date) %>"></span>
      <% end %>
    </div>
    <p class="availability__times"><%= ranges.map { |starts_at, ends_at| "#{starts_at.strftime('%-I:%M %p')}–#{ends_at.strftime('%-I:%M %p')}" }.join(" · ") %></p>
  </div>

  <details class="result__courts">
    <summary>View courts and times <span aria-hidden="true">+</span></summary>
    <p class="results__hint">Availability across courts is combined above. Check an individual court for your full session.</p>
    <% result.court_schedules.each do |court_name, periods| %>
      <div class="result__court-row">
        <span class="result__court-name"><%= court_name.presence || "Court" %></span>
        <div class="result__periods">
          <% periods.each do |period_name, period_slots| %>
            <div class="result__period">
              <span class="result__period-label"><%= period_name %></span>
              <div class="result__slot-chips">
                <% period_slots.each do |slot| %>
                  <span class="result__slot-chip"><%= format_slot_time_compact(slot) %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </details>
</article>
