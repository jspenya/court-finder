<main class="page" data-controller="search-form location" data-search-form-share-url-value="<%= root_path %>">
  <header class="mast">
    <%= link_to root_path, class: "brand", aria: { label: "Court Finder home" } do %>
      <svg viewBox="0 0 28 36" fill="none" aria-hidden="true"><rect x="2" y="2" width="24" height="32" rx="2" stroke="currentColor" stroke-width="2"/><path d="M2 18h24M2 11h24M2 25h24M14 2v9M14 25v9" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>Court Finder</span>
    <% end %>
    <span class="mast__location">Cagayan de Oro, Philippines</span>
  </header>

      <header class="hero">
        <h1 class="hero__title">Find your next court.</h1>
      </header>

  <div class="planner">
    <aside class="planner__search" aria-label="Plan your play time">
      <div id="search-form">
        <%= render "form", search_defaults: @search_defaults, search_error: @search_error %>
      </div>
    </aside>

    <section class="planner__results" aria-label="Venue availability">
      <div class="location-preference">
        <p id="location-status" class="results__hint" data-location-target="status" role="status" title="Location stays on this page. Change permission in your browser’s site settings."></p>
      </div>
      <div id="search-loading" class="loading" data-search-form-target="loading" hidden>
        <%= render "loading" %>
      </div>
      <%= turbo_frame_tag "results", data: { search_form_target: "results" } do %>
        <% if @search %>
          <%= render "results", search: @search %>
        <% end %>
      <% end %>
    </section>
  </div>
</main>
