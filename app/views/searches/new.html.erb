<main class="page"
      data-controller="search-form location"
      data-search-form-share-url-value="<%= root_path %>">
  <header class="hero">
    <div class="hero__content">
      <p class="hero__eyebrow">Cagayan de Oro · Pickleball Venues</p>
      <h1 class="hero__title">
        <span class="hero__title-line">Open</span>
        <span class="hero__title-line hero__title-line--accent">Courts</span>
      </h1>
      <p class="hero__lede">One search across all Pickleball venues. See open slots, then book on the venue site.</p>
    </div>
  </header>

  <div class="location-preference">
    <button type="button" class="button button--small button--outline" aria-describedby="location-status" data-location-target="button" data-action="location#locate">Use my location</button>
    <button type="button" class="button button--small button--outline" data-location-target="clear" data-action="location#clear" hidden>Clear location</button>
    <p id="location-status" class="results__hint" data-location-target="status" role="status">Share your location to show the closest venues first. Your location stays in this page.</p>
  </div>

  <div id="search-form">
    <%= render "form", search_defaults: @search_defaults, search_error: @search_error %>
  </div>

  <div id="search-loading" class="loading" data-search-form-target="loading" hidden>
    <%= render "loading" %>
  </div>

  <%= turbo_frame_tag "results", data: { search_form_target: "results" } do %>
    <% if @search %>
      <%= render "results", search: @search %>
    <% elsif @search_error.blank? %>
      <p class="results__hint">Tap the date and time field, then check availability across all venues.</p>
    <% end %>
  <% end %>
</main>
